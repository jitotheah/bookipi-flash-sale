# Configuration reference: the server reads process.env.
# Set variables in your shell; copying this file alone does not load them.

# ---- Sale configuration -------------------------------------------------
# PostgreSQL setup inserts these values only for a new SALE_ID.
# Existing sale windows, purchases and stock are preserved on setup/restart.
SALE_ID=1
TOTAL_STOCK=10
# SALE_START_AT=2026-11-01T10:00:00.000Z
# SALE_END_AT=2026-11-01T11:00:00.000Z
# Unset window values default to configuration-load time and one hour later.

# ---- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Inventory backend --------------------------------------------------
# memory   = reference implementation; single process, loses state on restart
# postgres = implemented durable store; coordinates independent API processes
# redis    = optional unimplemented driver; endpoints return 501
# Use postgres for the assignment's durable, multi-process demo.
INVENTORY_DRIVER=memory
DATABASE_URL=postgres://flash:flash@localhost:5432/flashsale
REDIS_URL=redis://localhost:6379

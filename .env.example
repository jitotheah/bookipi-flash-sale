# ---- Sale configuration -------------------------------------------------
# Leave SALE_START_AT / SALE_END_AT unset to get a sale that starts when the
# server boots and runs for one hour (handy for demos and tests).
# SALE_START_AT=2026-11-01T10:00:00.000Z
# SALE_END_AT=2026-11-01T11:00:00.000Z
TOTAL_STOCK=10

# ---- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ---- Inventory backend --------------------------------------------------
# memory = single-process, zero dependencies (default, good for tests)
# redis  = distributed, survives multiple API instances  <-- you implement this
INVENTORY_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ---- Durable store (step 4 of GUIDE.md) ---------------------------------
DATABASE_URL=postgres://flash:flash@localhost:5432/flashsale
